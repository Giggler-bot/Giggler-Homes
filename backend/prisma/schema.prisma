generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?
  firstName       String
  isEmailVerified Boolean    @default(false)
  isPhoneVerified Boolean    @default(false)
  lastName        String
  passwordHash    String
  phone           String     @unique
  role            UserRole   @default(USER)
  status          UserStatus @default(ACTIVE)
  properties      Property[] @relation("PropertyOwner")

  @@index([role])
  @@index([status])
  @@index([deletedAt])
}

model Property {
  id             String            @id @default(uuid())
  ownerId        String
  title          String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  bathrooms      Int?
  bedrooms       Int?
  deletedAt      DateTime?
  description    String
  isAvailable    Boolean           @default(true)
  isFeatured     Boolean           @default(false)
  isFurnished    Boolean           @default(false)
  locationId     String
  parkingSpaces  Int?
  propertyTypeId String
  slug           String            @unique
  squareMeters   Float?
  toilets        Int?
  yearBuilt      Int?
  listing        Listing[]
  medias         Media[]
  location       Location          @relation(fields: [locationId], references: [id])
  owner          User              @relation("PropertyOwner", fields: [ownerId], references: [id])
  propertyType   PropertyType      @relation(fields: [propertyTypeId], references: [id])
  amenity        PropertyAmenity[]

  @@index([ownerId])
  @@index([locationId])
  @@index([propertyTypeId])
  @@index([isAvailable])
  @@index([isFeatured])
  @@index([deletedAt])
}

model Location {
  id         String      @id @default(uuid())
  region     GhanaRegion
  district   String?
  area       String?
  landmark   String?
  slug       String      @unique
  latitude   Float?
  longitude  Float?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  properties Property[]

  @@unique([region, district, area])
  @@index([region, district, area])
}

model PropertyCategory {
  id            String         @id @default(uuid())
  name          String         @unique
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  propertyTypes PropertyType[]

  @@index([name])
}

model PropertyType {
  id          String           @id @default(uuid())
  categoryId  String
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  properties  Property[]
  category    PropertyCategory @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, name])
  @@index([categoryId])
}

model Listing {
  id                      String        @id @default(uuid())
  propertyId              String
  listingType             ListingType
  status                  ListingStatus @default(DRAFT)
  price                   Decimal       @db.Decimal(14, 2)
  currency                String        @default("GHS")
  rentPeriod              RentPeriod?
  negotiable              Boolean       @default(false)
  isFeatured              Boolean       @default(false)
  availabilityConfirmedAt DateTime?
  publishedAt             DateTime?
  expiresAt               DateTime?
  viewCount               Int           @default(0)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  deletedAt               DateTime?
  property                Property      @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
  @@index([status, listingType])
  @@index([listingType])
  @@index([price])
  @@index([isFeatured])
  @@index([expiresAt])
  @@index([deletedAt])
}

model Media {
  id         String    @id @default(uuid())
  propertyId String
  type       MediaType
  url        String
  publicId   String
  title      String?
  altText    String?
  sortOrder  Int       @default(0)
  isPrimary  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([type])
  @@index([isPrimary])
  @@index([deletedAt])
}

model Amenity {
  id         String            @id @default(uuid())
  name       String
  icon       String?
  category   AmenityCategory?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  deletedAt  DateTime?
  properties PropertyAmenity[]

  @@index([category])
  @@index([deletedAt])
}

model PropertyAmenity {
  propertyId String
  amenityId  String
  createdAt  DateTime @default(now())
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
  @@index([amenityId])
}

enum UserRole {
  USER
  OWNER
  AGENCY
  HOTEL
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DEACTIVATED
}

enum GhanaRegion {
  GREATER_ACCRA
  ASHANTI
  CENTRAL
  EASTERN
  WESTERN
  WESTERN_NORTH
  VOLTA
  OTI
  NORTHERN
  NORTH_EAST
  SAVANNAH
  UPPER_EAST
  UPPER_WEST
  BONO
  BONO_EAST
  AHAFO
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  EXPIRED
  ARCHIVED
  SOLD
  RENTED
}

enum ListingType {
  RENT
  SALE
  SHORT_STAY
  LEASE
}

enum RentPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum MediaType {
  IMAGE
  VIDEO
}

enum AmenityCategory {
  SECURITY
  UTILITIES
  COMFORT
  OUTDOOR
  PARKING
  CONNECTIVITY
}
