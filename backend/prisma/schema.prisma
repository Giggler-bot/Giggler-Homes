generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  firstName       String
  isEmailVerified Boolean   @default(false)
  isPhoneVerified Boolean   @default(false)
  lastName        String
  passwordHash    String
  phone           String    @unique

  role              UserRole   @default(USER)
  status            UserStatus @default(ACTIVE)
  properties        Property[] @relation("PropertyOwner")
  favorites         Favorite[]
  sentInquiries     Inquiry[]  @relation("InquirySender")
  receivedInquiries Inquiry[]  @relation("InquiryOwner")

  userVerification     userVerification?
  businessVerification BusinessVerification?

  submittedOwnershipVerifications OwnershipVerification[] @relation("OwnershipVerificationSubmitter")
  reviewedVerifications           userVerification[]      @relation("UserVerificationReviewer")
  reviewedOwnershipVerifications  OwnershipVerification[] @relation("OwnershipVerificationReviewer")
  reviewedBusinessVerifications   BusinessVerification[]  @relation("BusinessVerificationReviewer")

  @@index([role])
  @@index([status])
  @@index([deletedAt])
}

model Property {
  id                    String                 @id @default(uuid())
  ownerId               String
  title                 String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  bathrooms             Int?
  bedrooms              Int?
  deletedAt             DateTime?
  description           String
  isAvailable           Boolean                @default(true)
  isFeatured            Boolean                @default(false)
  isFurnished           Boolean                @default(false)
  locationId            String
  parkingSpaces         Int?
  propertyTypeId        String
  slug                  String                 @unique
  squareMeters          Float?
  toilets               Int?
  yearBuilt             Int?
  listing               Listing[]
  medias                Media[]
  location              Location               @relation(fields: [locationId], references: [id])
  owner                 User                   @relation("PropertyOwner", fields: [ownerId], references: [id])
  propertyType          PropertyType           @relation(fields: [propertyTypeId], references: [id])
  amenity               PropertyAmenity[]
  ownershipVerification OwnershipVerification?

  @@index([ownerId])
  @@index([locationId])
  @@index([propertyTypeId])
  @@index([isAvailable])
  @@index([isFeatured])
  @@index([deletedAt])
}

model Location {
  id         String      @id @default(uuid())
  region     GhanaRegion
  district   String?
  area       String?
  landmark   String?
  slug       String      @unique
  latitude   Float?
  longitude  Float?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  properties Property[]

  @@unique([region, district, area])
  @@index([region, district, area])
}

model PropertyCategory {
  id            String         @id @default(uuid())
  name          String         @unique
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  propertyTypes PropertyType[]

  @@index([name])
}

model PropertyType {
  id          String           @id @default(uuid())
  categoryId  String
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  properties  Property[]
  category    PropertyCategory @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, name])
  @@index([categoryId])
}

model Listing {
  id                      String        @id @default(uuid())
  propertyId              String
  listingType             ListingType
  status                  ListingStatus @default(DRAFT)
  price                   Decimal       @db.Decimal(14, 2)
  currency                String        @default("GHS")
  rentPeriod              RentPeriod?
  negotiable              Boolean       @default(false)
  isFeatured              Boolean       @default(false)
  availabilityConfirmedAt DateTime?
  publishedAt             DateTime?
  expiresAt               DateTime?
  viewCount               Int           @default(0)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  deletedAt               DateTime?

  property  Property   @relation(fields: [propertyId], references: [id])
  favorites Favorite[]
  inquires  Inquiry[]

  @@index([propertyId])
  @@index([status, listingType])
  @@index([listingType])
  @@index([price])
  @@index([isFeatured])
  @@index([expiresAt])
  @@index([deletedAt])
}

model Media {
  id         String    @id @default(uuid())
  propertyId String
  type       MediaType
  url        String
  publicId   String
  title      String?
  altText    String?
  sortOrder  Int       @default(0)
  isPrimary  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([type])
  @@index([isPrimary])
  @@index([deletedAt])
}

model Amenity {
  id         String            @id @default(uuid())
  name       String
  icon       String?
  category   AmenityCategory?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  deletedAt  DateTime?
  properties PropertyAmenity[]

  @@index([category])
  @@index([deletedAt])
}

model PropertyAmenity {
  propertyId String
  amenityId  String
  createdAt  DateTime @default(now())
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
  @@index([amenityId])
}

model Favorite {
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([listingId])
}

model Inquiry {
  id          String        @id @default(uuid())
  listingId   String
  senderId    String
  ownerId     String
  message     String
  status      InquiryStatus @default(OPEN)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  respondedAt DateTime?
  closedAt    DateTime?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sender  User    @relation("InquirySender", fields: [senderId], references: [id], onDelete: Cascade)
  owner   User    @relation("InquiryOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([senderId])
  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
}

model userVerification {
  id              String                   @id @default(cuid())
  userId          String                   @unique
  status          VerificationStatus       @default(PENDING)
  idType          VerificationDocumentType
  idNumber        String
  document        VerificationDocument[]
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("UserVerificationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
}

model OwnershipVerification {
  id         String @id @default(cuid())
  propertyId String @unique

  submittedById String
  proofType     VerificationDocumentType

  documents VerificationDocument[]

  status          VerificationStatus @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  submittedBy User     @relation("OwnershipVerificationSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)
  reviewer    User?    @relation("OwnershipVerificationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
}

model BusinessVerification {
  id                 String                 @id @default(cuid())
  ownerId            String                 @unique
  businessType       BusinessType
  businessName       String
  registrationNumber String
  documents          VerificationDocument[]
  status             VerificationStatus     @default(PENDING)
  reviewedBy         String?
  reviewedAt         DateTime?
  rejectionReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  reviewer User? @relation("BusinessVerificationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
}

model VerificationDocument {
  id         String                   @id @default(cuid())
  storageKey String
  fileUrl    String?
  docType    VerificationDocumentType
  uploadedAt DateTime                 @default(now())

  userVerificationId      String?
  ownershipVerificationId String?
  businessVerificationId  String?

  userVerification      userVerification?      @relation(fields: [userVerificationId], references: [id], onDelete: Cascade)
  ownershipVerification OwnershipVerification? @relation(fields: [ownershipVerificationId], references: [id], onDelete: Cascade)
  businessVerification  BusinessVerification?  @relation(fields: [businessVerificationId], references: [id], onDelete: Cascade)

  @@index([userVerificationId])
  @@index([ownershipVerificationId])
  @@index([businessVerificationId])
}

enum UserRole {
  USER
  OWNER
  AGENCY
  HOTEL
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DEACTIVATED
}

enum GhanaRegion {
  GREATER_ACCRA
  ASHANTI
  CENTRAL
  EASTERN
  WESTERN
  WESTERN_NORTH
  VOLTA
  OTI
  NORTHERN
  NORTH_EAST
  SAVANNAH
  UPPER_EAST
  UPPER_WEST
  BONO
  BONO_EAST
  AHAFO
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  EXPIRED
  ARCHIVED
  SOLD
  RENTED
}

enum ListingType {
  RENT
  SALE
  SHORT_STAY
  LEASE
}

enum RentPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum MediaType {
  IMAGE
  VIDEO
}

enum AmenityCategory {
  SECURITY
  UTILITIES
  COMFORT
  OUTDOOR
  PARKING
  CONNECTIVITY
}

enum InquiryStatus {
  OPEN
  RESPONDED
  CLOSED
}

enum VerificationDocumentType {
  PASSPORT
  NATIONAL_ID
  DRIVERS_LICENSE
  VOTERS_ID
  PROPERTY_DEED
  UTILITY_BILL
  LEASE_AGREEMENT
  BUSINESS_REGISTRATION
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum BusinessType {
  AGENCY
  HOTEL
}
